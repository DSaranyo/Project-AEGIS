ting Longitude / RAAN in degrees [Default: 120]: \"\n  )\n  raan_deg = float(raan_input) if raan_input.strip() != \"\" else 120.0\n\n  thresh_input = input(\n      \"Enter Safety Warning Threshold in km [Default: 800]: \"\n  )\n  safety_threshold_km = (\n      float(thresh_input) if thresh_input.strip() != \"\" else 800.0\n  )\nexcept ValueError:\n  alt_km, inc_deg, raan_deg, safety_threshold_km = 550.0, 51.6, 120.0, 800.0\n\nprint(\n    f\"\\n[Config] Alt: {alt_km} km | Inc: {inc_deg}° | RAAN:\"\n    f\" {raan_deg}° | Threshold: {safety_threshold_km} km\"\n)\n\nprint(\"\\n[1/4] Loading real-time space debris data from CelesTrak...\")\nts = load.timescale()\nt0 = ts.now()\n\nurl = \"https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=tle\"\nsatellites = load.tle_file(url)\nprint(f\"Successfully loaded {len(satellites)} objects from the database!\")\n\n# 2. Enhanced J2-Corrected Vector Math Model for Custom Satellite\nR_EARTH = 6371.0\nJ2 = 0.00108263\nr = R_EARTH + alt_km\nmu = 398600.44\n\norbital_period_sec = 2 * np.pi * np.sqrt((r ** 3) / mu)\nn0 = (2 * np.pi) / orbital_period_sec\np = r\n\ntime_steps_min = np.arange(0, 180, 2)\ntime_steps_sec = time_steps_min * 60\n\nraan_dot = -1.5 * n0 * J2 * (R_EARTH / p) ** 2 * np.cos(np.radians(inc_deg))\ninc = np.radians(inc_deg)\nbase_raan = np.radians(raan_deg)\nraan_t = base_raan + (raan_dot * time_steps_sec)\n\nsat_x = r * (\n    np.cos(raan_t) * np.cos(raan_t + n0 * time_steps_sec)\n    - np.sin(raan_t) * np.sin(raan_t + n0 * time_steps_sec) * np.cos(inc)\n)\nsat_y = r * (\n    np.sin(raan_t) * np.cos(raan_t + n0 * time_steps_sec)\n    + np.cos(raan_t) * np.sin(raan_t + n0 * time_steps_sec) * np.cos(inc)\n)\nsat_z = r * (np.sin(raan_t + n0 * time_steps_sec) * np.sin(inc))\nsat_positions = np.array([sat_x, sat_y, sat_z])\n\ntimes = ts.tt(jd=t0.tt + time_steps_min / (24 * 60))\n\nwarning_count = 0\nall_min_distances = []\nall_relative_speeds = []\nscanned_sats = []\n\nprint(\"\\n[2/4] Running J2-corrected co